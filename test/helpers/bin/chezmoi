#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Test double for chezmoi. Records argv; exit code steered by STUB_CHEZMOI_RC
# (default 0) so a test can exercise the "non-fatal apply" fallback.
{ printf 'chezmoi'; printf ' %s' "$@"; printf '\n'; } >> "${STUB_LOG:-/dev/null}"
exit "${STUB_CHEZMOI_RC:-0}"
