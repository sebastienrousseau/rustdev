# ~/.bashrc — interactive shell config (langdev common)
# SPDX-License-Identifier: MIT
#
# Language-agnostic. Per-language repos add a ~/.bashrc.d/<lang>.sh
# fragment (sourced below) for language-specific PATH/aliases.

# Only run for interactive shells.
case $- in
  *i*) ;;
  *) return ;;
esac

# --- History: sane, shared, de-duplicated -----------------------------------
HISTCONTROL=ignoreboth        # no dup lines, no lines starting with space
HISTSIZE=10000
HISTFILESIZE=20000
# On a read-only rootfs, $HOME is read-only; keep history on the tmpfs
# state dir so writes succeed (and vanish with the disposable container).
if [ -n "${XDG_STATE_HOME:-}" ]; then
  mkdir -p "$XDG_STATE_HOME/bash" 2>/dev/null || true
  HISTFILE="$XDG_STATE_HOME/bash/history"
fi
shopt -s histappend           # append, don't clobber
shopt -s checkwinsize         # keep LINES/COLUMNS correct after resize

# --- Safe defaults -----------------------------------------------------------
umask 022                     # not group/world writable by default
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R'
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

# --- Prompt: minimal, shows git branch when available ------------------------
__ld_git_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/.*/ (&)/'
}
if [ -n "${TERM:-}" ] && [ "$TERM" != "dumb" ]; then
  PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;33m\]$(__ld_git_branch)\[\e[0m\]\$ '
else
  PS1='\u@\h:\w\$ '
fi

# --- Colour support ----------------------------------------------------------
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b 2>/dev/null)" || true
fi
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# --- Aliases -----------------------------------------------------------------
if [ -f "$HOME/.bash_aliases" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.bash_aliases"
fi

# --- Language-specific fragments --------------------------------------------
# Each <lang>dev image drops files into ~/.bashrc.d/ at build time.
if [ -d "$HOME/.bashrc.d" ]; then
  for __f in "$HOME"/.bashrc.d/*.sh; do
    [ -r "$__f" ] || continue
    # shellcheck source=/dev/null
    . "$__f"
  done
  unset __f
fi

# --- Completion --------------------------------------------------------------
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    # shellcheck source=/dev/null
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    # shellcheck source=/dev/null
    . /etc/bash_completion
  fi
fi
