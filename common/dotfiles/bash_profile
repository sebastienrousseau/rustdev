# ~/.bash_profile — login shell entry point (langdev common)
# SPDX-License-Identifier: MIT
#
# Keep login and interactive config in one place: source .bashrc.
# POSIX login shells read this; interactive non-login read .bashrc.

# shellcheck source=/dev/null
if [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
